# Riot Games API Key
# Obtenela iniciando sesión en https://developer.riotgames.com/
# Nota: La Development API Key se renueva cada 24 horas.
RIOT_API_KEY=RGAPI-TU-CLAVE-AQUI

# Pool multi-proyecto (opcional, recomendado para throughput):
# Cada key debe provenir de un PROYECTO distinto si se quiere cubrir más cuota,
# pero OJO: Riot encripta el PUUID por proyecto (HMAC con project_secret), por lo
# que el mismo humano tendrá un PUUID distinto bajo cada key de este pool.
# El orden de esta lista define el project_index (0 = canónico) y DEBE mantenerse
# estable entre ejecuciones; tras añadir/rotar keys, ejecutar:
#   python scripts/register_key_project.py
# para resolver los PUUIDs de cada jugador en cada proyecto (Account-V1).
# RIOT_API_KEYS=RGAPI-KEY-PROYECTO-1,RGAPI-KEY-PROYECTO-2

# Servidor de plataforma por defecto (ejemplos: la2 = LAS, la1 = LAN, na1 = NA, br1 = BR, euw1 = EUW, kr = KR)
DEFAULT_PLATFORM=la2

# Enrutamiento regional (regional routing) para Account-V1 y Match-V5:
# 'americas' -> para LAS (la2), LAN (la1), NA (na1), BR (br1)
# 'europe'   -> para EUW (euw1), EUNE (eun1), TR (tr1), RU (ru)
# 'asia'     -> para KR (kr), JP (jp1)
# 'sea'      -> para OCE (oc1), PH, SG, TH, TW, VN
DEFAULT_REGIONAL_ROUTING=americas

# Sincronización automática de Base de Datos SQLite (Git Hook pre-push)
# DEBE ser una RUTA LOCAL del disco (carpeta sincronizada por Google Drive para Escritorio),
# NO una URL de drive.google.com: el script copia con shutil.copy2, que no habla HTTP.
# Ejemplo Windows: GOOGLE_DRIVE_BACKUP_PATH=G:\Mi unidad\CarpetaCompartidaProyectoML
GOOGLE_DRIVE_BACKUP_PATH=

# Ranura de proyecto (`project_index`) de cada key del pool, separadas por comas.
# Opcional: por defecto la ranura es la posición en el pool.
# OBLIGATORIO cuando el pool NO contiene todos los proyectos históricos — por
# ejemplo una sola key propia cuando las demás pertenecen a otra persona. Sin
# esto, el registro escribe en la ranura 0 y borra el `key_hint` ajeno.
# Para saber qué ranura corresponde:
#     python scripts/identity/register_key_project.py --dry-run --tiers CHALLENGER
# (Jaccard > 0.5 con un proyecto = rotación de esa ranura; ~0.00 = proyecto nuevo.)
# RIOT_API_PROJECT_INDICES=3
